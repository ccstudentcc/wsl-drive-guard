#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_CONFIG_PATH="/etc/wsl-drive-guard/system.conf"
FALLBACK_CONFIG_PATH="${SCRIPT_DIR}/system.conf"

load_config() {
  local config_path=""

  if [[ -f "$DEFAULT_CONFIG_PATH" ]]; then
    config_path="$DEFAULT_CONFIG_PATH"
  elif [[ -f "$FALLBACK_CONFIG_PATH" ]]; then
    config_path="$FALLBACK_CONFIG_PATH"
  else
    printf '%s\n' "Missing system config." >&2
    exit 1
  fi

  # shellcheck disable=SC1090
  . "$config_path"
}

usage() {
  cat <<'EOF'
Usage:
  sudo win-drive-session rw <drive> [drive...]

Example:
  sudo win-drive-session rw c
  sudo win-drive-session rw d e

This opens a nested interactive shell, keeps the selected drives writable for
that shell only, and restores them to read-only when the shell exits.
EOF
}

require_root() {
  if ((EUID != 0)); then
    printf '%s\n' "win-drive-session changes mount state and must be run with sudo." >&2
    usage >&2
    exit 1
  fi
}

drive_mode_cmd() {
  printf '%s\n' "${SCRIPT_DIR}/win-drive-mode"
}

open_session_shell() {
  local shell_status=0

  if [[ -n "${SUDO_USER:-}" ]] && [[ "$SUDO_USER" != "root" ]]; then
    local shell_path=""
    shell_path="$(getent passwd "$SUDO_USER" | cut -d: -f7)"
    shell_path="${shell_path:-/bin/bash}"
    sudo -H --preserve-env=WSL_DRIVE_SESSION_DRIVES -u "$SUDO_USER" -- "$shell_path" -i || shell_status=$?
  else
    "${SHELL:-/bin/bash}" -i || shell_status=$?
  fi

  return "$shell_status"
}

if [[ $# -lt 2 ]]; then
  usage >&2
  exit 1
fi

mode="$1"
shift

if [[ "$mode" != "rw" ]]; then
  printf '%s\n' "win-drive-session only supports temporary rw sessions." >&2
  usage >&2
  exit 1
fi

require_root

load_config

drives=()
for raw_drive in "$@"; do
  drive="${raw_drive,,}"

  if [[ ! "$drive" =~ ^[a-z]$ ]]; then
    printf '%s\n' "Invalid drive letter: ${raw_drive}" >&2
    exit 1
  fi

  drives+=("$drive")
done

applied=0

cleanup() {
  if ((applied)); then
    if ! "$(drive_mode_cmd)" ro "${drives[@]}"; then
      printf '%s\n' "Warning: failed to restore read-only mode for: ${drives[*]}" >&2
      return 1
    fi
  fi
}

handle_signal() {
  local signal_name="$1"
  trap - INT TERM
  cleanup || true
  kill "-${signal_name}" "$$"
}

trap 'handle_signal INT' INT
trap 'handle_signal TERM' TERM

printf 'Opening temporary rw shell for: %s\n' "${drives[*]}"
"$(drive_mode_cmd)" rw "${drives[@]}"
applied=1

export WSL_DRIVE_SESSION_DRIVES
WSL_DRIVE_SESSION_DRIVES="$(IFS=,; printf '%s' "${drives[*]}")"

printf 'Temporary rw shell is ready for: %s\n' "${drives[*]}"
printf '%s\n' "Run 'exit' to restore read-only mode."

shell_status=0
open_session_shell || shell_status=$?

cleanup_status=0
cleanup || cleanup_status=$?

if ((shell_status != 0)); then
  exit "$shell_status"
fi

exit "$cleanup_status"
