#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_CONFIG_PATH="/etc/wsl-drive-guard/system.conf"
FALLBACK_CONFIG_PATH="${SCRIPT_DIR}/system.conf"

load_config() {
  local config_path=""

  if [[ -f "$DEFAULT_CONFIG_PATH" ]]; then
    config_path="$DEFAULT_CONFIG_PATH"
  elif [[ -f "$FALLBACK_CONFIG_PATH" ]]; then
    config_path="$FALLBACK_CONFIG_PATH"
  else
    printf '%s\n' "Missing system config." >&2
    exit 1
  fi

  # shellcheck disable=SC1090
  . "$config_path"
}

load_config

printf "%-5s %-12s %-6s %s\n" "DRIVE" "MOUNTPOINT" "MODE" "SOURCE"

for drive in $WSL_GUARD_MANAGED_DRIVES; do
  mountpoint="${WSL_GUARD_MOUNT_ROOT%/}/${drive}"
  line="$(awk -v mp="$mountpoint" '$2 == mp && $3 == "9p" && $4 ~ /aname=drvfs;path=/ { print; exit }' /proc/mounts)"

  if [[ -z "$line" ]]; then
    continue
  fi

  opts="$(awk '{print $4}' <<<"$line")"
  source_name="${drive^^}:\\"
  mode="rw"

  if [[ ",${opts}," == *,ro,* ]]; then
    mode="ro"
  fi

  printf "%-5s %-12s %-6s %s\n" "${drive^^}" "$mountpoint" "$mode" "$source_name"
done
